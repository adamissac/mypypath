# Adaptive engine: its own virtualenv, and generated simulation data (large,
# reproducible from a seed). Reports, the frozen artifact and the parity
# fixtures are committed.
engine/.venv/
engine/data/
engine/**/__pycache__/
engine/.pytest_cache/
engine/*.egg-info/
.hypothesis/
engine/.hypothesis/

# Desktop app (Tauri): build output and the fetched/checksum-verified
# third-party runtime assets it bundles (Pyodide, CodeMirror, fonts).
# Reproducible from scripts/desktop-vendor-manifest.json — never committed,
# large binaries with no diff value.
/desktop-dist/
/.vendor-cache/
src-tauri/target/
src-tauri/gen/

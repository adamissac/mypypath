{
  "name": "mypypath",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.js\"",
    "serve": "python3 -m http.server 8080",
    "emulators": "firebase emulators:start --only auth,firestore",
    "seed": "node scripts/seed-classroom.mjs",
    "build:curriculum": "node scripts/build-curriculum.js",
    "build:data-course": "node scripts/build-data-course.cjs",
    "validate:checks": "node scripts/validate-checks.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^13.29.1",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
